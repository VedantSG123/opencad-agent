{
  "compilerOptions": {
    "target": "ES2022",
    // Preload must stay CommonJS (see src/preload.ts); "bundler" is the only
    // resolution mode TS 7 accepts alongside module: commonjs.
    "module": "commonjs",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/preload.ts"]
}
