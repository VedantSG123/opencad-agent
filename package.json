{
  "name": "opencad-desktop-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "electron"
  ],
  "scripts": {
    "dev": "bun run build:shared && concurrently -k -n \"frontend,electron\" -c \"blue,green\" \"(cd frontend && bun dev)\" \"(cd electron && bun dev)\"",
    "build:shared": "(cd shared && bun run build)",
    "build:frontend": "(cd frontend && bun run build)",
    "build:backend": "(cd backend && bun run build)",
    "build:electron": "(cd electron && bun run build)",
    "build": "bun run build:shared && bun run build:frontend && bun run build:backend && bun run build:electron",
    "lint": "oxlint --type-aware",
    "lint:fast": "oxlint",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:shared": "oxlint --type-aware shared",
    "lint:frontend": "oxlint --type-aware frontend",
    "lint:backend": "oxlint --type-aware backend",
    "lint:electron": "oxlint --type-aware electron",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck:shared": "(cd shared && bun run typecheck)",
    "typecheck:backend": "(cd backend && bun run typecheck)",
    "typecheck:frontend": "(cd frontend && bun run typecheck)",
    "typecheck:electron": "(cd electron && bun run typecheck)",
    "typecheck": "bun run build:shared && bun run typecheck:backend && bun run typecheck:frontend && bun run typecheck:electron",
    "package": "bun run build && (cd electron && bun run package)"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001"
  }
}
